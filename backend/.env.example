# ================================
# 🔧 Backend Environment Template
# ================================

# ----------------
# 🗄️ Database
# ----------------
# Lokaler PostgreSQL (Docker oder Host)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cargonaut?schema=public"

# ----------------
# 🔐 Authentication
# ----------------
# Sehr wichtig: Dieser Secret muss pro Umgebung anders sein!
JWT_SECRET="CHANGE_ME_SECRET_KEY"

# JWT Token Ablaufzeit
JWT_EXPIRES_IN="7d"

# ----------------
# 🌐 Server Config
# ----------------
# Standard Port für NestJS
PORT=3000

# ----------------
# 📁 File Upload Paths
# ----------------
# Where uploaded images are stored (Fastify Static)
UPLOADS_DIR="./uploads"

# Profile images
PROFILE_UPLOAD_DIR="./uploads/profile"

# Trip image uploads (optional später)
TRIP_UPLOAD_DIR="./uploads/trips"

# Vehicle image uploads
VEHICLE_UPLOAD_DIR="./uploads/vehicles"

# ----------------
# 🛠️ Prisma
# ----------------
# Nur für Debugging
PRISMA_LOG_LEVEL="info"

